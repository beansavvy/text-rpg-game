export function populateDB() {
  const currentLocation = '3';
  const characters = [];
  const skills = generateSkills();
  const items = generateItems();
  const enemies = generateEnemies(items, skills);
  const npcs = generateNPCs(items);
  const gameLocations = generateGameLocations(enemies, npcs);
  const scrollingText = generateScrollingText();
  const quests = generateQuests();
  const races = racesObj;
  const classes = classesObj;

  return {
    currentLocation: currentLocation,
    characters: characters,
    skills: skills,
    items: items,
    enemies: enemies,
    npcs: npcs,
    locations: gameLocations,
    scrollingTexts: scrollingText,
    quests: quests,
    races: races,
    classes: classes,
  };
}
