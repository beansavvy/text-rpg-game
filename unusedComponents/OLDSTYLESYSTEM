public/styles/enterLocation.css
body {
  height: 98vh;
  width: 100%;
  margin: 0px;
}
.main-game-container {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0px;
  padding: 0px;
  height: 96vh;
  width: 100%;
  min-width: 1000px;
}

.scrolling-paper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

#paper-canvas {
  height: 99vh;
  width: 100vw;
  overflow: hidden;
}

.continue-message {
  position: absolute;
  right: 120px;
  bottom: -20px;
  font-size: 16px;
  font-weight: bold;
  animation: flash 1s infinite;
}

@keyframes flash {
  0%,
  100% {
    opacity: 1;
  }
  40%,
  60% {
    opacity: 0;
  }
}

#click-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000000;
  cursor: pointer;
}

.equipment-popup-container {
  width: 99vw;
  height: 99vh;
  position: absolute;
}

.equipment-popup {
  position: fixed;
  top: 20%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000; /* Ensure it is above other elements */
  background: white; /* Background color */
  padding: 20px; /* Space inside the popup */
  border-radius: 8px; /* Optional rounded corners */
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Optional shadow for styling */
  max-width: 90%; /* Optional: make it responsive */
  max-height: 90%; /* Optional: handle very large content gracefully */
  overflow: auto; /* Handle overflow for large content */
}

.popup-content {
  position: relative;
}

.scroll-text-linebreak {
  padding: 3px;
  display: block;
}

.scroll-text-indent {
  display: inline-block;
  width: 2em; /* Adjust the width to your preference */
}

#canvas-text {
}

.left-panel {
  display: flex;
  flex-direction: column;
  border-right: 1px solid black;
  min-height: 100%;
}

.dialogue-box-header {
  text-align: center;
  border-bottom: 1px solid lightgray;
  font-weight: bold;
}

.dialogue-box {
  margin-bottom: 20px;
  min-height: 200px;
  border-bottom: 1px solid gray;
}

.dialogue-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#dialogue-options-table {
  table-layout: fixed;
}

.dialogue-btns-table {
  margin: auto;
}

.dialogue-cell {
  border: 1px solid black;
  width: 50%;
  padding: 0px;
  height: fit-content;
}

.blank-dialogue-cell {
  width: 50%;
  border: none;
  background-color: white;
}

.dialogue-button {
  vertical-align: middle;
  width: 150px;
  max-width: 150px;
  height: 100%;
  min-height: 34px;
  font-size: 15px;
  border: none;
  background: white;
  padding: 5px 20px;
  margin: 0px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.middle-panel {
  /* Add styles for the interactive features */
  height: 98vh;
}

.right-panel {
  border-left: 1px solid black;
}

#right-panel-table {
  border-spacing: 0px;
  height: 100%;
  float: right;
  width: 100%;
}

#menu-invEq-wrapper-table {
  height: 95%;
  width: 100%;
  min-width: 295px;
}

#menu-invEq-gold-container {
  padding: 0px;
  width: 100%;
  border-top: 1px solid darkgray;
  text-align: center;
}

#right-panel-table tr td {
  padding: 0px;
}

#menu-popout {
  width: 100%;
  height: 100%;
  /* padding-right: 10px; */
  overflow: scroll;
  scrollbar-width: none;
}

.scrollable-content {
  scrollbar-width: 1px;
}

.menu-btn-td {
  padding: 0px;
  border: none;
  border-bottom: 1px solid black;
  min-width: 75px;
  text-align: center;
}

.dialogue-box-section {
  width: 100%;
  text-align: center;
}

.dialogue-box-section-header {
  border-top: 3px solid black;
  border-bottom: 1px solid gray;
  width: 100%;
  font-weight: bold;
  text-align: center;
  margin-bottom: 10px;
  margin-top: 10px;
}

#menu-inv-wrapper-table,
#menu-equipped-wrapper-table {
  width: 100%;
  margin-right: 0px;
  border-collapse: collapse;
  /* height: 35vh; */
  display: block;
  overflow-y: scroll;
  scrollbar-width: none;
}

#inventory-btn-td {
  border-top: 1px solid black;
}

.inventory-row {
  height: 24px;
  border-bottom: 1px solid lightgray;
}

.table-fill-excess-td {
  width: 100%;
}

.menu-btn {
  border: none;
  background: none;
}

#menu-popout-stats-table {
  border-collapse: collapse;
  width: 100%;
}

#menu-popout-stats-table tr {
  border-bottom: 1px solid lightgray;
}

#menu-popout-stats-table tr td:first-child {
  text-align: right;
  padding-right: 20px;
}

#menu-popout-stats-table tr td:nth-child(2) {
  width: 100%;
}

#menu-tabs-table {
  border-spacing: 0px;
  width: 68px;
  height: 100%;
}

.td-vert-gap-fill {
  height: 100%;
  border-left: 1px solid black;
}

.inv-item-container {
  width: 120px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  /* display: inline-block; */
  padding: 3px 0px;
}

.tooltiptext-header {
  text-align: center;
  width: 100%;
  border-bottom: 1px solid grey;
  display: block;
  font-weight: bold;
}

/* globalStyles.css */
.combat-container {
  display: flex;
  flex-direction: column;
}

.combat-grid {
  border-collapse: collapse;
  width: fit-content;
  margin: 10px auto;
}

.grid-cell {
  width: 20px;
  height: 20px;
  border: 1px solid #aaa;
  text-align: center;
}

.player-cell {
  background-color: lightblue;
}

.enemy-cell {
  background-color: lightcoral;
}

.movement-range-cell {
  background-color: lightgreen;
  opacity: 0.8;
  cursor: pointer;
}

.enemy-section {
  text-align: center;
}

.enemy-name-wrapper {
  width: fit-content;
  margin: auto;
}

.enemy-name {
  width: fit-content;
  font-size: 1.5em;
  cursor: pointer;
  margin: auto;
}

.enemy-image-placeholder {
  height: 0px;
  background-color: lightgray;
  margin: 10px 0;
}

.player-section {
  margin-top: 20px;
}

.player-stats {
  display: flex;
  flex-direction: column;
}

.health-bar,
.mana-bar,
.stamina-bar {
  position: relative;
  /* background-color: #ddd; */
  border-bottom: 1px solid #ccc;
  /* margin: 5px 0; */
}

.fill {
  /* height: 100%; */
  height: 15px;
  background-color: #4caf50; /* Green for health */
}

.mana-bar .fill {
  background-color: #2196f3; /* Blue for mana */
}

.stamina-bar .fill {
  background-color: #ffc107; /* Yellow for stamina */
}

.turn-indicator {
  margin-bottom: 10px;
  text-align: center;
}

.turn-indicator ul {
  list-style: none;
  padding: 0;
  display: flex;
  justify-content: center;
  gap: 10px;
}

.turn-indicator li {
  padding: 5px 10px;
  border: 1px solid #ddd;
  border-radius: 5px;
  background-color: #f9f9f9;
}

.turn-indicator .current-turn {
  background-color: #ffeeba;
  border-color: #ffc107;
  font-weight: bold;
}

.tabs {
  display: flex;
  justify-content: space-around;
  margin-top: 10px;
}

.tabs button {
  padding: 10px;
  cursor: pointer;
}

.tab-content {
  margin-top: 20px;
}

.tab-content > div {
  display: none;
}

.tab-content > div.active {
  display: block;
}

.bar-numbers {
  display: inline-block;
}

.combat-menu-btn-td {
  border-right: 1px solid gray;
}

.combat-menu-btn {
  padding: 5px 10px;
}

.td-hori-gap-fill {
  width: 100%;
  border-bottom: 1px solid gray;
}

.player-combat-menu {
  width: 100%;
}

.tooltippopup {
  position: absolute;
  z-index: 1001;
  background-color: #333;
  color: #fff;
  padding: 10px;
  border-radius: 5px;
  opacity: 1;
  transition: opacity 0.2s;
  white-space: normal; /* Ensure text wraps */
  width: 300px; /* Set a maximum width for the tooltip */
  box-sizing: border-box;
}

.tooltip-wrapper {
  width: fit-content;
  height: fit-content;
  padding: 0px;
  margin: 0px;
}

.enemy-tooltip-section-header {
  text-align: center;
  width: 100%;
  border-bottom: 1px solid rgb(243, 243, 243);
}

.tooltip-tail {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  pointer-events: none;
}

.tooltip-tail-above {
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  border-width: 10px 10px 0;
  border-color: #333 transparent transparent transparent;
  pointer-events: none;
}

.tooltip-tail-below {
  top: -10px;
  left: 50%;
  transform: translateX(-50%);
  border-width: 0 10px 10px;
  border-color: transparent transparent #333 transparent;
  pointer-events: none;
}

.tooltippopup-child-wrapper {
  width: fit-content;
  height: fit-content;
}

.tooltiptext-seperator {
  display: block;
  height: 10px;
}

.stats-table {
  width: 100%;
}

.stats-table tr {
  width: 100%;
}

.section-header {
  padding: 5px;
  width: 100%;
  border-bottom: 3px solid black;
  text-align: center;
}

.stats-table-seperator {
  width: 100%;
  text-align: center;
  border-bottom: 2px solid black;
  border-top: 1px solid black;
}

.stats-table-seperator-2nd {
  width: 100%;
  text-align: center;
  border-top: 1px solid gray;
  border-bottom: 1px solid gray;
}

/* globalStyles.css */

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  font-family: Arial, sans-serif;
}

.loading-icon {
  width: 40px;
  height: 40px;
  border: 5px solid rgba(0, 0, 0, 0.1);
  border-top-color: #000;
  border-radius: 50%;
  animation: spin 1s infinite linear;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
